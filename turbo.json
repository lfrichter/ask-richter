{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "NPM_CONFIG_PRODUCTION"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "jidoka": {
      "dependsOn": ["check-types", "lint", "build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
