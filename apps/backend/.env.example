# ------------------------------------------------
# ARQUIVO DE EXEMPLO PARA O BACKEND (.env)
# ------------------------------------------------

# --- Configuração de Provedores de IA ---
# LLM Provider ativo: 'gemini' (padrão), 'ollama' (dev local), 'openrouter' ou 'huggingface'
AI_PROVIDER="gemini"
# Provedores de fallback em ordem de prioridade (separados por vírgula): ex: "openrouter,huggingface,ollama"
AI_FALLBACK_PROVIDERS="openrouter,huggingface,ollama"

# Embedding Provider ativo: 'gemini' (padrão)
EMBEDDING_PROVIDER="gemini"

# --- Gemini (Google GenAI) ---
# Chave da API do Gemini (obrigatória se AI_PROVIDER="gemini" ou EMBEDDING_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# --- Ollama (Desenvolvimento Local) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:7b"

# --- OpenRouter (Opcional / Provedor alternativo) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"

# --- Hugging Face (Opcional / Provedor alternativo) ---
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.1-8B-Instruct:novita"

# --- Credenciais do Supabase (obrigatórias para armazenamento do índice FAISS) ---
SUPABASE_URL="https://[SEU-ID-DO-PROJETO].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-secreta-aqui"
SUPABASE_BUCKET_NAME="faiss-index"
